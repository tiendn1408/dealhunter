# ==============================================================================
# DealHunter — Backend Environment Configuration Example (LOCAL DEV)
# ==============================================================================
# Copy thanh .env de chay local. Cach lay tung gia tri: docs/third_party_and_environment_requirements.md
# Production (Docker Compose): KHONG copy nguyen file nay, xem docs/deployment/production-deployment-guide.md muc 2
# (APP_ENV, JWT_SECRET, AUTH_COOKIE_SECURE, mat khau Postgres phai khac gia tri dev ben duoi).

# Application & Server
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication & Security
# Tao chuoi ngau nhien it nhat 32 ky tu: openssl rand -base64 32
# Gia tri mac dinh duoi day CHI dung cho local dev; production se tu choi khoi dong neu dung gia tri nay.
JWT_SECRET=dealhunter-super-secret-jwt-key-32bytes-secure!
# Access token ngan han + refresh token xoay vong (cookie HttpOnly)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Cookie refresh chi gui qua HTTPS (mac dinh: false khi APP_ENV=development). Production bat buoc true.
AUTH_COOKIE_SECURE=false

# Google OAuth 2.0 (Dang nhap & Di tru tai khoan) — bat buoc o production
# Lay tu: Google Cloud Console -> APIs & Services -> Credentials (OAuth Client ID loai Web)
# Frontend dung cung gia tri qua NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Email tai khoan Google (phan cach dau phay) duoc phep tao voucher qua API. De trong = khong ai tao duoc.
ADMIN_EMAILS=

# PostgreSQL Database (Luu tru nguoi dung, san pham, snapshot gia, canh bao)
# POSTGRES_* dung cho container Postgres cua docker-compose; ung dung Go chi doc DATABASE_URL.
# docker-compose.yml (dev) luon mo cong 5433 tren may; POSTGRES_PORT chi de ghi nho, khong doi duoc cong.
# Mat khau co ky tu dac biet (@ : / ? #) phai URL-encode trong DATABASE_URL.
POSTGRES_USER=dealuser
POSTGRES_PASSWORD=dealpass
POSTGRES_DB=dealdb
POSTGRES_PORT=5433
DATABASE_URL=postgres://dealuser:dealpass@localhost:5433/dealdb?sslmode=disable

# Redis (Stream Queue cong viec, Cache so sanh & Luu tru Zalo Token)
# REDIS_PORT: cong tren may cua container Redis (docker-compose.yml); ung dung Go chi doc REDIS_URL.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Scraper & Worker Pool Settings
# So job doc gia chay song song
WORKER_CONCURRENCY=10
# Chu ky kiem tra gia mac dinh (giay)
DEFAULT_POLL_INTERVAL=1800
# Thoi gian cho toi da moi lan doc trang san (Go duration: 10s, 1m)
FETCH_TIMEOUT=10s
MAX_RETRY=5

# Affiliate (Phase 3.5): chuyen link san thanh link tiep thi lien ket khi nguoi dung bam "Mua"
# Mac dinh TAT. Moi san chi duoc chuyen khi co CA *_AFFILIATE_ID va *_URL_TEMPLATE do chuong trinh affiliate cap;
# thieu mot trong hai => dung ACCESSTRADE_DEEPLINK_URL (neu co) hoac giu link goc.
# Template phai chua {URL} (link da URL-encode) hoac {RAW_URL}; co the dung them {SUB_ID} va {AFFILIATE_ID}.
# Template khong chua {URL}/{RAW_URL} bi bo qua (tranh dua moi san pham ve cung mot trang).
AFFILIATE_ENABLED=false
SHOPEE_AFFILIATE_ID=
SHOPEE_AFFILIATE_URL_TEMPLATE=
LAZADA_AFFILIATE_ID=
LAZADA_AFFILIATE_URL_TEMPLATE=
TIKTOK_AFFILIATE_ID=
TIKTOK_AFFILIATE_URL_TEMPLATE=
# Deeplink AccessTrade (dung chung cho moi san), vi du dang: https://go.isclix.com/deep_link/<ma_publisher>?url={URL}&utm_content={SUB_ID}
ACCESSTRADE_DEEPLINK_URL=

# Zalo OA / ZNS Notification Engine (GAP-04)
# ZALO_ENABLED=false: khong gui tin nao; thong bao duoc ghi la failed (chua cau hinh Zalo). Khong co che do gia lap.
# Luu y: co ZALO_REFRESH_TOKEN hoac ZALO_OA_ACCESS_TOKEN thi Zalo tu BAT, ke ca khi ZALO_ENABLED=false.
ZALO_ENABLED=false
# ID ung dung tu Zalo for Developers (developers.zalo.me)
ZALO_APP_ID=
# Khoa bi mat ung dung tu Zalo for Developers
ZALO_OA_SECRET_KEY=
# Refresh token ban dau duoc cap tu OAuth v4 de worker tu dong refresh token 24/7
ZALO_REFRESH_TOKEN=
# Access token (neu co san, neu de trong thi he thong se tu refresh tu ZALO_REFRESH_TOKEN)
ZALO_OA_ACCESS_TOKEN=
# ID mau tin nhan ZNS canh bao gia giam da duoc Zalo duyet (bien trong mau: price_before, price_after, deal_url)
ZALO_TEMPLATE_ID=
# Mau ZNS gui ma xac minh so dien thoai khi lien ket Zalo (bien trong mau: otp). De trong = khong lien ket duoc Zalo
ZALO_OTP_TEMPLATE_ID=
# Khoa bi mat dung xac thuc chu ky webhook HMAC-SHA256 (mac) gui tu Zalo. De trong = dung ZALO_OA_SECRET_KEY
ZALO_WEBHOOK_SECRET=

# IP/CIDR cua reverse proxy duoc tin header X-Forwarded-For (cach nhau dau phay). De trong = khong tin header nao
# (dung khi API nhan ket noi truc tiep). Production (docker-compose.prod.yml): mac dinh chi tin localhost va
# gateway cua mang Docker (DEALHUNTER_GATEWAY, mac dinh 172.30.240.1) - khong tin ca dai Docker
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Chi dung khi trien khai bang docker-compose.prod.yml (khong anh huong khi chay local)
# ------------------------------------------------------------------------------
# URL API ma web goi, nhung vao luc BUILD image web (bat buoc voi compose prod)
# NEXT_PUBLIC_API_URL=https://dealhunter.vn/api/v1
# ID extension DealHunter Assistant (Chrome Web Store) de web gui phien dang nhap sang extension. De trong = tat
# EXTENSION_ID=
# Gateway mang Docker ma API tin X-Forwarded-For (mac dinh 172.30.240.1). Chi doi khi doi subnet mang compose
# DEALHUNTER_GATEWAY=172.30.240.1
