# ==============================================================================
# DealHunter — Backend Environment Configuration Example
# ==============================================================================

# Application & Server
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Database (Application & Docker Compose)
POSTGRES_USER=dealuser
POSTGRES_PASSWORD=dealpass
POSTGRES_DB=dealdb
POSTGRES_PORT=5433
DATABASE_URL=postgres://dealuser:dealpass@localhost:5433/dealdb?sslmode=disable

# Redis Stream Queue & Comparison Cache
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Scraper & Worker Pool Settings
WORKER_CONCURRENCY=10
DEFAULT_POLL_INTERVAL=1800
FETCH_TIMEOUT=10s
MAX_RETRY=5

# Zalo OA / ZNS Notification Engine (Phase 2)
# Dat ZALO_ENABLED=false de su dung che do Mock Sandbox an toan (khong ton phi ZNS)
ZALO_ENABLED=false
ZALO_OA_ACCESS_TOKEN=
ZALO_TEMPLATE_ID=
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
