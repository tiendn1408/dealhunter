# ==============================================================================
# DealHunter — Backend Environment Configuration Example
# ==============================================================================

# Application & Server
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication & Security
# Tao chuoi ngau nhien it nhat 32 ky tu: openssl rand -base64 32
JWT_SECRET=dealhunter-super-secret-jwt-key-32bytes-secure!

# Google OAuth 2.0 (Dang nhap & Di tru tai khoan)
# Lay tu: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=

# PostgreSQL Database (Luu tru nguoi dung, san pham, snapshot gia, canh bao)
POSTGRES_USER=dealuser
POSTGRES_PASSWORD=dealpass
POSTGRES_DB=dealdb
POSTGRES_PORT=5433
DATABASE_URL=postgres://dealuser:dealpass@localhost:5433/dealdb?sslmode=disable

# Redis (Stream Queue cong viec, Cache so sanh & Luu tru Zalo Token)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Scraper & Worker Pool Settings
WORKER_CONCURRENCY=10
DEFAULT_POLL_INTERVAL=1800
FETCH_TIMEOUT=10s
MAX_RETRY=5

# Zalo OA / ZNS Notification Engine (GAP-04)
# Dat ZALO_ENABLED=false de su dung che do Mock Sandbox an toan (khong ton phi ZNS)
ZALO_ENABLED=false
# ID ung dung tu Zalo for Developers (developers.zalo.me)
ZALO_APP_ID=
# Khoa bi mat ung dung tu Zalo for Developers
ZALO_OA_SECRET_KEY=
# Refresh token ban dau duoc cap tu OAuth v4 de worker tu dong refresh token 24/7
ZALO_REFRESH_TOKEN=
# Access token (neu co san, neu de trong thi he thong se tu refresh tu ZALO_REFRESH_TOKEN)
ZALO_OA_ACCESS_TOKEN=
# ID mau tin nhan ZNS canh bao gia giam da duoc Zalo duyet
ZALO_TEMPLATE_ID=
# Khoa bi mat dung xac thuc chu ky webhook HMAC-SHA256 (mac) gui tu Zalo
ZALO_WEBHOOK_SECRET=
