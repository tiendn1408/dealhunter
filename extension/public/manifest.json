{
  "manifest_version": 3,
  "name": "DealHunter Assistant",
  "short_name": "DealHunter",
  "version": "1.0.0",
  "description": "Universal high-speed sniper and fast clicker for midnight drops (00:00), flash sales, ticket booking, and e-commerce price intelligence.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*/*.svg",
        "*://*/*.svg?*",
        "*://*/*.pdf",
        "*://*/*.pdf?*",
        "*://*/*.xml",
        "*://*/*.xml?*",
        "*://*/*.json",
        "*://*/*.json?*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.caffiliate.vn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "caffiliate_bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DealHunter Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://localhost:3100/*",
      "https://dealhunter.vn/*",
      "https://www.dealhunter.vn/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "caffiliate_bridge.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
